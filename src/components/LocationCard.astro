---
import Card from './Card.astro';

interface Props {
  location?: string;
  timezone?: string;
  mapImage?: string;
}

const { 
  location = "Porto, Portugal",
  timezone = "Europe/Lisbon",
  mapImage = "/images/porto.jpg"
} = Astro.props;
---

<Card variant="media" class="location-card group h-full min-h-[180px] lg:min-h-[240px]">
  <div class="relative h-full">
    <!-- Map Background Image -->
    <div class="absolute inset-0 overflow-hidden">
      <img 
        src={mapImage}
        alt={`Map showing ${location}`}
        width="640"
        height="480"
        loading="eager"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-102"
      />
    </div>
    
    <!-- Darkening overlay for legibility -->
    <div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/40 to-black/20"></div>
    
    <!-- Content - Glass card -->
    <div class="absolute bottom-2 left-2 right-2 lg:bottom-4 lg:left-4 lg:right-4 z-10">
      <div class="glass-card rounded-lg p-2 lg:p-4">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-1 lg:gap-4">
          <div>
            <p class="text-[8px] lg:text-[10px] uppercase tracking-wider text-cream/70 mb-0.5 lg:mb-1">Working remote from</p>
            <h3 class="text-base lg:text-xl font-bold text-cream drop-shadow-sm">{location}</h3>
          </div>
          <div class="lg:text-right">
            <p class="text-[8px] lg:text-[10px] uppercase tracking-wider text-cream/60 mb-0.5 lg:mb-1">Local Time</p>
            <p class="font-mono text-lg lg:text-2xl font-bold text-cream drop-shadow-sm" id="local-time" data-timezone={timezone}>--:--</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Card>

<script>
  function updateTime() {
    const timeEl = document.getElementById('local-time');
    if (timeEl) {
      const timezone = timeEl.dataset.timezone || 'Europe/Lisbon';
      const now = new Date();
      const options: Intl.DateTimeFormatOptions = { 
        hour: '2-digit', 
        minute: '2-digit',
        hour12: false,
        timeZone: timezone
      };
      timeEl.textContent = now.toLocaleTimeString('en-GB', options);
    }
  }
  updateTime();
  setInterval(updateTime, 1000);
</script>

<style>
  @reference "../styles/global.css";

  .glass-card {
    backdrop-filter: blur(10px);
    border: 1px solid rgba(248, 237, 217, 0.15);
  }
</style>

