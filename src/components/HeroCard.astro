---
import Card from './Card.astro';
import CompanyLink from './CompanyLink.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  statusText?: string;
  headline?: string;
  highlightedWord?: string;
  description?: string;
  currentRole?: string;
  companyName?: string;
  companyUrl?: string;
  companyLogo?: string;
  companyColor?: string;
  companyDescription?: string;
  companyTags?: string[];
  companyLocation?: string;
}

const {
  statusText = "Available for projects",
  headline = "Building digital",
  highlightedWord = "experiences",
  description = "I'm Diogo, a Senior Software Engineer with over a decade of experience in full-stack and blockchain development.",
  currentRole = "Senior Software Engineer",
  companyName = "Applied Blockchain",
  companyUrl = "https://www.appliedblockchain.com/",
  companyLogo = "/images/applied-blockchain-logo.jpg",
  companyColor = "#2563EB",
  companyDescription = "Building enterprise blockchain solutions for global companies like Shell, KLM, Vodafone, and Bank of America. Specializing in Web3, DeFi, and privacy-focused technologies.",
  companyTags = ["Web3", "DeFi", "Smart Contracts"],
  companyLocation = "London, UK • Founded 2015"
} = Astro.props;
---

<Card variant="hero" class="h-full min-h-[400px] lg:min-h-[500px]">
  <div class="flex h-full flex-col justify-between py-6">
    <div>
      <!-- Status badge -->
      <div class="mb-8">
        <StatusBadge text={statusText} />
      </div>
      
      <!-- Main heading -->
      <h1 class="mb-6 text-4xl font-bold tracking-tight text-text-primary sm:text-5xl lg:text-6xl">
        {headline}<br/>
        <span class="hero-gradient">{highlightedWord}</span>
      </h1>
      
      <p class="max-w-lg text-lg leading-relaxed text-text-secondary lg:text-lg">
        {description}
      </p>
    </div>
    
    <!-- Currently Working Section -->
    <div>
      <p class="mb-2 text-xs font-medium uppercase tracking-wider text-text-muted">Currently</p>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <span class="text-md font-medium text-text-primary">{currentRole}</span>
        <span class="text-sm text-text-muted">@</span>
        <CompanyLink
          name={companyName}
          url={companyUrl}
          logo={companyLogo}
          color={companyColor}
          description={companyDescription}
          tags={companyTags}
          location={companyLocation}
        />
      </div>
    </div>
  </div>
</Card>

<style>
  @reference "../styles/global.css";

  .hero-gradient {
    background: linear-gradient(135deg, #d5a908 0%, #FFA54E 50%, #FF5F43 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
</style>

