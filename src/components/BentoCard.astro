---
import Card from './Card.astro';

export interface Props {
  size?: 'sm' | 'wide' | 'tall' | 'lg';
  href?: string;
  class?: string;
  gradient?: boolean;
}

const { size = 'sm', href, class: className = '', gradient = false } = Astro.props;
---

<Card 
  variant="default" 
  size={size} 
  href={href} 
  class={className} 
  gradient={gradient}
>
  <slot />
</Card>
