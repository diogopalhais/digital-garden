---
import Card from './Card.astro';

interface Props {
  name?: string;
  title?: string;
  image?: string;
}

const { 
  name = "Diogo Palhais", 
  title = "Senior Software Engineer",
  image = "/images/profile.png"
} = Astro.props;
---

<Card variant="media" class="profile-card group h-full min-h-[180px] lg:min-h-[240px]">
  <div class="relative h-full">
    <img 
      src={image}
      alt={`${name} - ${title}`}
      width="480"
      height="480"
      loading="eager"
      class="h-full w-full object-cover object-top transition-all duration-500 group-hover:scale-102 brightness-80"
    />
    <div class="absolute bottom-0 left-0 right-0 p-4 lg:p-6">
      <h2 class="text-sm lg:text-lg font-bold text-text-primary">{name}</h2>
      <p class="text-xs lg:text-sm text-text-secondary">{title}</p>
    </div>
  </div>
</Card>

