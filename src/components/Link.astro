---
export interface Props {
  href: string;
  variant?: 'default' | 'underline';
  external?: boolean;
  class?: string;
}

const { href, variant = 'default', external = false, class: className = '' } = Astro.props;

const externalProps = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};

const baseClasses = 'text-accent transition-colors duration-200 hover:text-accent-hover';
const underlineClasses = 'border-b border-accent/50 hover:border-accent-hover';
---

<a
  href={href}
  class:list={[
    baseClasses,
    variant === 'underline' && underlineClasses,
    className,
  ]}
  {...externalProps}
>
  <slot />
</a>
