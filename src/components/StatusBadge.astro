---
interface Props {
  text?: string;
}

const { text = "Available for projects" } = Astro.props;
---

<div class="status-badge">
  <span class="status-dot">
    <span class="status-ping"></span>
    <span class="status-core"></span>
  </span>
  <span class="status-text">{text}</span>
</div>

<style>
  .status-badge {
    @apply inline-flex items-center gap-3 rounded-full border border-accent/30 bg-accent/10 px-5 py-2.5;
  }

  .status-dot {
    @apply relative flex h-2.5 w-2.5;
  }

  .status-ping {
    @apply absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75;
  }

  .status-core {
    @apply relative inline-flex h-2.5 w-2.5 rounded-full bg-accent;
  }

  .status-text {
    @apply text-sm font-medium text-accent;
  }
</style>

