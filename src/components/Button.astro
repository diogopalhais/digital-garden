---
export interface Props {
  variant?: 'primary' | 'secondary';
  href?: string;
  class?: string;
  external?: boolean;
}

const { variant = 'primary', href, class: className = '', external = false } = Astro.props;

const Element = href ? 'a' : 'button';
const externalProps = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};

const baseClasses = 'inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-medium transition-all duration-200';
const variantClasses = {
  primary: 'bg-accent text-background hover:bg-accent-hover',
  secondary: 'border border-border bg-card text-text-primary hover:border-border-hover hover:bg-card-hover',
};
---

<Element
  href={href}
  class:list={[baseClasses, variantClasses[variant], className]}
  {...externalProps}
>
  <slot />
</Element>
