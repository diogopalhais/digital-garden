---
interface Props {
  name: string;
  url: string;
  logo: string;
  color?: string;
  description?: string;
  tags?: string[];
  location?: string;
}

const {
  name,
  url,
  logo,
  color = "#2563EB",
  description,
  tags = [],
  location,
} = Astro.props;

const hasPopup = description || tags.length > 0 || location;
---

<div class="company-link-wrapper relative z-50">
  <a 
    href={url}
    target="_blank" 
    rel="noopener noreferrer"
    class="company-link inline-flex items-center gap-2.5 rounded-md border px-3 py-1.5 text-sm font-semibold transition-all"
    style={`border-color: ${color}40; background-color: ${color}15; color: ${color};`}
  >
    <img 
      src={logo}
      alt=""
      class="h-5 w-5 rounded object-contain"
    />
    {name}
    <svg class="h-3.5 w-3.5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
    </svg>
  </a>
  
  {hasPopup && (
    <div class="company-popup absolute left-0 bottom-full z-50 mb-3 w-80 opacity-0 invisible transition-all duration-200 -translate-y-2">
      <div class="popup-card rounded-xl border border-border bg-card p-5 shadow-2xl shadow-black/50">
        <div class="flex items-start gap-4">
          <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl overflow-hidden bg-white/5">
            <img 
              src={logo}
              alt={name}
              class="h-12 w-12 object-contain"
            />
          </div>
          <div class="flex-1 min-w-0">
            <h4 class="text-base font-bold text-text-primary">{name}</h4>
            {location && <p class="mt-1 text-xs font-medium text-text-muted">{location}</p>}
          </div>
        </div>
        
        {description && (
          <p class="mt-4 text-sm leading-relaxed text-text-secondary">
            {description}
          </p>
        )}
        
        {tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span 
                class="rounded-md border px-2.5 py-1 text-xs font-semibold"
                style={`border-color: ${color}30; background-color: ${color}20; color: ${color};`}
              >
                {tag}
              </span>
            ))}
          </div>
        )}
        
        <div class="absolute -bottom-2 left-6 h-4 w-4 rotate-45 border-r border-b border-border bg-card"></div>
      </div>
    </div>
  )}
</div>

<style>
  .company-link-wrapper:hover .company-popup {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .company-link:hover {
    filter: brightness(1.2);
    transform: scale(1.02);
  }
</style>

