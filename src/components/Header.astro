---
const base = import.meta.env.BASE_URL;

const navItems = [
  { href: `${base}`, label: ' ~' },
  { href: `${base}about/`, label: 'about' },
  { href: `${base}now/`, label: 'now' },
  { href: `${base}watching/`, label: 'watching' },
  { href: `${base}uses/`, label: 'uses' },
];

const currentPath = Astro.url.pathname;
---

<header class="py-6">
  <nav class="flex justify-center">
    <ul class="nav-container">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || 
          (item.href !== base && currentPath.startsWith(item.href));
        return (
          <li>
            <a
              href={item.href}
              class:list={[
                'nav-link',
                isActive && 'nav-link-active',
              ]}
            >
              <span class="nav-slash">/</span><span class="nav-label" data-text={item.label}>{item.label}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </nav>

  <!-- Mobile Menu Button -->
  <button
    id="mobile-menu-btn"
    class="mobile-menu-btn"
    aria-label="Toggle menu"
    aria-expanded="false"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="h-5 w-5"
    >
      <line x1="4" x2="20" y1="12" y2="12"></line>
      <line x1="4" x2="20" y1="6" y2="6"></line>
      <line x1="4" x2="20" y1="18" y2="18"></line>
    </svg>
  </button>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="mobile-menu hidden"
  >
    <ul class="mobile-nav-list">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || 
          (item.href !== base && currentPath.startsWith(item.href));
        return (
          <li>
            <a
              href={item.href}
              class:list={[
                'mobile-nav-link',
                isActive && 'mobile-nav-link-active',
              ]}
            >
              <span class="text-accent">/</span>{item.label}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!isOpen));
  });
</script>

<style>
  @reference "../styles/global.css";

  .nav-container {
    @apply hidden md:flex items-center gap-6;
  }

  .nav-link {
    @apply relative px-1 py-2 text-sm font-medium text-text-secondary transition-all duration-200;
  }

  .nav-link:hover {
    @apply text-text-primary -translate-y-20;
  }

  .nav-link-active {
    @apply text-text-primary font-bold transition-all duration-400;
  }

  .nav-slash {
    @apply text-accent font-semibold text-lg opacity-0 transition-all duration-400 pr-1;
  }

  .nav-link:hover .nav-slash,
  .nav-link-active .nav-slash {
    @apply opacity-100;
  }

  .nav-label {
    @apply transition-all duration-200;
  }

  /* Reserve space for bold text to prevent layout shift */
  .nav-label::after {
    content: attr(data-text);
    @apply block h-0 overflow-hidden font-bold invisible;
  }

  .nav-link:hover .nav-label {
    @apply underline underline-offset-4;
  }

  /* Mobile Menu Button */
  .mobile-menu-btn {
    @apply absolute top-0 right-6 flex h-10 w-10 items-center justify-center text-text-secondary transition-all duration-200 md:hidden;
  }

  .mobile-menu-btn:hover {
    @apply text-accent -translate-y-0.5;
  }

  /* Mobile Menu */
  .mobile-menu {
    @apply absolute inset-x-4 top-14 rounded-xl border border-border bg-card p-4 md:hidden;
  }

  .mobile-nav-list {
    @apply flex flex-col gap-2;
  }

  .mobile-nav-link {
    @apply block px-2 py-2 text-base font-medium text-text-secondary transition-all duration-200;
  }

  .mobile-nav-link:hover {
    @apply text-text-primary underline underline-offset-4;
  }

  .mobile-nav-link-active {
    @apply text-text-primary font-bold;
  }
</style>
