---
import TechStackMarquee from './TechStackMarquee.jsx';

interface Props {
  title?: string;
}

const { title = "Tech Stack" } = Astro.props;
---

<div class="tech-marquee-card">
  <div class="px-8 pt-8 pb-4">
    <h3 class="text-sm font-medium uppercase tracking-wider text-text-secondary/70">{title}</h3>
  </div>
  <div class="pb-12">
    <TechStackMarquee client:load />
  </div>
</div>

<style>
  .tech-marquee-card {
    @apply rounded-2xl overflow-hidden;
    background: rgba(24, 24, 27, 0.3);
  }
</style>

