---
export interface Props {
  variant?: 'default' | 'accent';
  href?: string;
  class?: string;
}

const { variant = 'default', href, class: className = '' } = Astro.props;

const Element = href ? 'a' : 'span';
---

<Element
  href={href}
  class:list={[
    'badge',
    variant === 'accent' && 'badge-accent',
    className,
  ]}
>
  <slot />
</Element>

<style>
  .badge {
    @apply inline-flex items-center gap-1.5 rounded-full border border-border bg-card px-3 py-1 text-xs font-medium text-text-secondary transition-colors;
  }

  .badge:hover {
    @apply border-border-hover bg-card-hover text-text-primary;
  }

  .badge-accent {
    @apply border-accent/30 bg-accent/10 text-accent;
  }

  .badge-accent:hover {
    @apply border-accent/50 bg-accent/20;
  }
</style>

