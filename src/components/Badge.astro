---
export interface Props {
  variant?: 'default' | 'accent';
  href?: string;
  class?: string;
}

const { variant = 'default', href, class: className = '' }: Props = Astro.props;

const Element = href ? 'a' : 'span';

const baseClasses = 'inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-medium transition-colors';
const variantClasses = {
  default: 'border-border bg-card text-text-secondary hover:border-border-hover hover:bg-card-hover hover:text-text-primary',
  accent: 'border-accent/30 bg-accent/10 text-accent hover:border-accent/50 hover:bg-accent/20',
};
---

<Element
  href={href}
  class:list={[baseClasses, variantClasses[variant], className]}
>
  <slot />
</Element>
