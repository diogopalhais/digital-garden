---
import BaseLayout from '@layouts/BaseLayout.astro';
import ContentContainer from '@components/ContentContainer.astro';
import ContentHeader from '@components/ContentHeader.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'whoami');
const { Content } = await page.render();
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <section class="mx-auto max-w-5xl px-4 sm:px-6 py-16 md:py-24">
    <ContentContainer>
      <ContentHeader title={page.data.title} />

      <article>
        <Content />
      </article>
    </ContentContainer>
  </section>
</BaseLayout>
