---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'about');
const { Content } = await page.render();
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <section class="container-content py-16">
    <header class="mb-12">
      <p class="mb-2 text-sm font-medium text-accent">About Me</p>
      <h1 class="mb-6 text-4xl font-bold text-text-primary md:text-5xl">
        Diogo Palhais
      </h1>
    </header>

    <article class="prose-about">
      <Content />
    </article>
  </section>
</BaseLayout>

<style is:global>
  .prose-about {
    @apply max-w-none text-text-secondary;
  }

  .prose-about > p:first-of-type {
    @apply text-lg leading-relaxed text-text-secondary/80 mb-10 pb-10 border-b border-border/30;
  }

  .prose-about h2 {
    @apply text-lg font-bold text-text-primary mt-14 mb-6 first:mt-0 pb-3 border-b border-accent/30;
  }

  .prose-about h3 {
    @apply text-sm font-semibold text-text-primary mt-8 mb-2 pl-3 border-l-2 border-accent/50;
  }

  .prose-about p {
    @apply mb-4 leading-relaxed;
  }

  .prose-about strong {
    @apply text-text-primary font-medium;
  }

  .prose-about em {
    @apply text-text-muted not-italic text-sm;
  }

  .prose-about ul {
    @apply space-y-2 list-none pl-0 mb-6;
  }

  .prose-about li {
    @apply relative pl-4 text-text-secondary;
  }

  .prose-about li::before {
    @apply content-[''] absolute left-0 top-[0.6em] h-1 w-1 rounded-full bg-accent;
  }

  .prose-about a {
    @apply text-accent hover:text-accent-hover transition-colors;
  }

  .prose-about hr {
    @apply border-border/30 my-10;
  }
</style>
