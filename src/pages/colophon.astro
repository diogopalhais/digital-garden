---
import BaseLayout from '@layouts/BaseLayout.astro';
import ContentContainer from '@components/ContentContainer.astro';
import ContentHeader from '@components/ContentHeader.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'colophon');
const { Content } = await page.render();
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <section class="mx-auto max-w-5xl px-4 sm:px-6 py-16 md:py-24">
    <ContentContainer>
      <ContentHeader title={page.data.title} />

      <article class="prose-colophon">
        <Content />
      </article>
    </ContentContainer>
  </section>
</BaseLayout>

<style is:global>
  @reference "../styles/global.css";

  /* Colophon page specific styling */
  .prose-colophon code {
    @apply font-mono text-sm bg-border/50 px-1.5 py-0.5 rounded text-text-primary;
  }

  .prose-colophon table {
    @apply w-full border-collapse mb-6;
  }

  .prose-colophon th,
  .prose-colophon td {
    @apply border px-4 py-2 text-left;
    border-color: color-mix(in srgb, var(--color-border) 50%, transparent);
  }

  .prose-colophon th {
    @apply bg-card text-text-primary font-medium;
  }
</style>
