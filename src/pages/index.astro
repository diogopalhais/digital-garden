---
import BaseLayout from '@layouts/BaseLayout.astro';
import TechStackMarquee from '@components/TechStackMarquee.jsx';
import SpotifyNowPlaying from '@components/SpotifyNowPlaying.jsx';
---

<BaseLayout
  title="Home"
  description="Diogo Palhais - Senior Software Engineer based in Porto, Portugal. Full-stack and blockchain development with over a decade of experience."
>
  <section class="container-page py-12 md:py-20">
    
    <!-- Bento Grid -->
    <div class="bento-container">
      
      <!-- Row 1: Hero + Photo + Location -->
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-6 lg:grid-rows-2">
        
        <!-- Hero Card - Main -->
        <div class="relative lg:col-span-4 lg:row-span-2">
          <div class="hero-card h-full min-h-[400px] lg:min-h-[500px]">
            <div class="flex h-full flex-col justify-between p-8 lg:p-12">
              <div>
                <!-- Status badge -->
                <div class="mb-8 inline-flex items-center gap-3 rounded-full border border-accent/30 bg-accent/10 px-5 py-2.5">
                  <span class="relative flex h-2.5 w-2.5">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"></span>
                    <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-accent"></span>
                  </span>
                  <span class="text-sm font-medium text-accent">Available for projects</span>
                </div>
                
                <!-- Main heading -->
                <h1 class="mb-6 text-4xl font-bold tracking-tight text-text-primary sm:text-5xl lg:text-6xl">
                  Building digital<br/>
                  <span class="hero-gradient">experiences</span>
                </h1>
                
                <p class="max-w-xl text-lg leading-relaxed text-text-secondary lg:text-xl">
                  I'm Diogo, a Senior Software Engineer with over a decade of experience in full-stack and blockchain development.
                </p>
              </div>
              
              <!-- Currently Working Section -->
              <div class="mt-8">
                <p class="mb-3 text-xs font-medium uppercase tracking-wider text-text-muted">Currently</p>
                <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                  <span class="text-sm font-medium text-text-primary">Senior Software Engineer</span>
                  <span class="text-sm text-text-muted">@</span>
                  <div class="company-link-wrapper relative">
                    <a 
                      href="https://www.appliedblockchain.com/" 
                      target="_blank" 
                      rel="noopener noreferrer"
                      class="company-link inline-flex items-center gap-2 rounded-lg border border-[#2563EB]/30 bg-[#2563EB]/10 px-3 py-1.5 text-sm font-medium text-[#3B82F6] transition-all hover:border-[#2563EB]/50 hover:bg-[#2563EB]/20"
                    >
                      <img 
                        src="/images/applied-blockchain-logo.jpg" 
                        alt=""
                        class="h-4 w-4 rounded object-contain"
                      />
                      Applied Blockchain
                      <svg class="h-3 w-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                      </svg>
                    </a>
                    
                    <!-- Hover Popup -->
                    <div class="company-popup absolute left-0 top-full z-50 mt-3 w-80 opacity-0 invisible transition-all duration-200 translate-y-2">
                      <div class="rounded-xl border border-border bg-card p-4 shadow-2xl shadow-black/40">
                        <div class="flex items-start gap-4">
                          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl overflow-hidden">
                            <img 
                              src="/images/applied-blockchain-logo.jpg" 
                              alt="Applied Blockchain"
                              class="h-12 w-12 object-contain"
                            />
                          </div>
                          <div class="flex-1 min-w-0">
                            <h4 class="font-bold text-text-primary">Applied Blockchain</h4>
                            <p class="mt-0.5 text-xs text-text-muted">London, UK • Founded 2015</p>
                          </div>
                        </div>
                        
                        <p class="mt-3 text-sm leading-relaxed text-text-secondary">
                          Building enterprise blockchain solutions for global companies like Shell, KLM, Vodafone, and Bank of America. Specializing in Web3, DeFi, and privacy-focused technologies.
                        </p>
                        <div class="mt-3 flex flex-wrap gap-1.5">
                          <span class="rounded-full bg-[#2563EB]/10 px-2 py-0.5 text-xs text-[#3B82F6]">Web3</span>
                          <span class="rounded-full bg-[#2563EB]/10 px-2 py-0.5 text-xs text-[#3B82F6]">DeFi</span>
                          <span class="rounded-full bg-[#2563EB]/10 px-2 py-0.5 text-xs text-[#3B82F6]">Smart Contracts</span>
                        </div>
                        <!-- Arrow -->
                        <div class="absolute -top-2 left-6 h-4 w-4 rotate-45 border-l border-t border-border bg-card"></div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Profile Photo & Location Cards - Side by side on mobile -->
        <div class="col-span-1 grid grid-cols-2 gap-4 lg:col-span-2 lg:grid-cols-1 lg:row-span-2">
          <!-- Profile Photo Card -->
          <div class="bento-card group h-full min-h-[180px] lg:min-h-[240px] overflow-hidden p-0">
            <div class="relative h-full">
              <img 
                src="/images/profile.png" 
                alt="Diogo Palhais - Senior Software Engineer"
                class="h-full w-full object-cover object-top transition-all duration-700 group-hover:scale-105 brightness-50"
              />
              <!-- Warm overlay -->
              <div class="absolute inset-0 bg-gradient-to-br from-orange/10 via-transparent to-tomato/10 mix-blend-overlay"></div>
              <!-- Bottom gradient -->
              <div class="absolute inset-0 bg-gradient-to-t from-background via-background/50 to-transparent"></div>
              <!-- Content -->
              <div class="absolute bottom-0 left-0 right-0 p-4 lg:p-6">
                <h2 class="text-sm lg:text-lg font-bold text-text-primary">Diogo Palhais</h2>
                <p class="text-xs lg:text-sm text-text-secondary">Senior Software Engineer</p>
              </div>
            </div>
          </div>
          
          <!-- Location Card - Porto -->
          <div class="bento-card group h-full min-h-[180px] lg:min-h-[240px] overflow-hidden p-0">
            <div class="relative h-full">
              <!-- Map Background Image -->
              <div class="absolute inset-0 overflow-hidden">
                <img 
                  src="/images/map.png" 
                  alt="Map showing Porto, Portugal"
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
                />
              </div>
              
              <!-- Warm overlay -->
              <div class="absolute inset-0 bg-gradient-to-br from-accent/10 via-black/30 to-orange/10"></div>
              
              <!-- Vignette -->
              <div class="absolute inset-0 shadow-[inset_0_0_80px_rgba(0,0,0,0.6)]"></div>
              
              <!-- Content - Glass card -->
              <div class="absolute top-2 left-2 right-2 lg:top-4 lg:left-4 lg:right-4 z-10">
                <div class="glass-card rounded-xl p-2 lg:p-4">
                  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-1 lg:gap-4">
                    <div>
                      <p class="text-[8px] lg:text-[10px] uppercase tracking-wider text-cream/50 mb-0.5 lg:mb-1">Working remote from</p>
                      <h3 class="text-base lg:text-xl font-bold text-cream">Porto, Portugal</h3>
                    </div>
                    <div class="lg:text-right">
                      <p class="text-[8px] lg:text-[10px] uppercase tracking-wider text-cream/40 mb-0.5 lg:mb-1">Local Time</p>
                      <p class="font-mono text-lg lg:text-2xl font-bold text-cream" id="local-time">--:--</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Row 2: Tech Stack Marquee -->
      <div class="mt-4">
        <div class="tech-marquee-card">
          <div class="px-8 pt-8 pb-4">
            <h3 class="text-sm font-medium uppercase tracking-wider text-text-secondary/70">Tech Stack</h3>
          </div>
          <div class="pb-12">
            <TechStackMarquee client:load />
          </div>
        </div>
      </div>
        
      <!-- Row 3: Spotify & Connect -->
      <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
        <!-- Spotify Now Playing Card -->
        <div class="bento-card spotify-card group relative overflow-hidden">
          <div class="relative">
            <div class="px-6 pt-6 pb-2 flex items-center gap-2">
              <svg class="h-5 w-5 text-[#1DB954]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
              </svg>
              <h3 class="text-sm font-medium uppercase tracking-wider text-text-secondary/70">Now Playing</h3>
            </div>
            <SpotifyNowPlaying client:load />
          </div>
        </div>
        
        <!-- Connect Card -->
        <div class="bento-card group/connect relative overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-br from-accent/5 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover/connect:opacity-100"></div>
          <div class="relative flex h-full flex-col items-center justify-center gap-3 p-4">
            <p class="text-xs text-text-muted">Find me on the web <span class="text-accent">@diogopalhais</span></p>
            <div class="flex items-center gap-4">
              <a href="https://github.com/diogopalhais" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="GitHub">
                <svg class="h-[18px] w-[18px]" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
              </a>
              <a href="https://twitter.com/diogopalhais" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Twitter">
                <svg class="h-[18px] w-[18px]" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>
              <a href="https://linkedin.com/in/diogopalhais" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="LinkedIn">
                <svg class="h-[18px] w-[18px]" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
              <a href="https://instagram.com/diogopalhais" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Instagram">
                <svg class="h-[18px] w-[18px]" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </a>
              <a href="mailto:palhais.diogo@gmail.com" class="social-icon" aria-label="Email">
                <svg class="h-[18px] w-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
      
    </div>

    
  </section>
</BaseLayout>

<script>
  function updateTime() {
    const timeEl = document.getElementById('local-time');
    if (timeEl) {
      const now = new Date();
      const options: Intl.DateTimeFormatOptions = { 
        hour: '2-digit', 
        minute: '2-digit',
        hour12: false,
        timeZone: 'Europe/Lisbon'
      };
      timeEl.textContent = now.toLocaleTimeString('en-GB', options);
    }
  }
  updateTime();
  setInterval(updateTime, 1000);
</script>

<style>
  /* Hero Card */
  .hero-card {
    @apply rounded-3xl border border-border/50 bg-card;
  }

  .hero-gradient {
    background: linear-gradient(135deg, #80D580 0%, #FFA54E 50%, #FF5F43 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Buttons */
  .btn-primary {
    @apply inline-flex items-center gap-2 rounded-xl bg-accent px-6 py-3 text-sm font-semibold text-background transition-all duration-200;
  }
  
  .btn-primary:hover {
    @apply bg-accent-hover;
    transform: translateY(-2px);
    box-shadow: 0 10px 20px -10px rgba(128, 213, 128, 0.5);
  }

  .btn-secondary {
    @apply inline-flex items-center gap-2 rounded-xl border-2 border-border bg-card px-6 py-3 text-sm font-semibold text-text-primary transition-all duration-200;
  }
  
  .btn-secondary:hover {
    @apply border-accent/50 bg-accent/5;
    transform: translateY(-2px);
  }

  /* Bento Cards */
  .bento-card {
    @apply rounded-2xl border border-border bg-card transition-all duration-300;
  }
  
  .bento-card:hover {
    @apply border-border-hover;
    transform: translateY(-4px);
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.3);
  }

  /* Card color variants */
  .card-accent {
    background: linear-gradient(135deg, rgba(128, 213, 128, 0.03) 0%, transparent 50%, rgba(128, 213, 128, 0.02) 100%);
  }
  
  .card-mint {
    background: linear-gradient(135deg, rgba(128, 213, 128, 0.05) 0%, transparent 50%, rgba(128, 213, 128, 0.03) 100%);
  }
  
  .card-orange {
    background: linear-gradient(135deg, rgba(255, 165, 78, 0.05) 0%, transparent 50%, rgba(255, 95, 67, 0.03) 100%);
  }
  
  .card-tomato {
    background: linear-gradient(135deg, rgba(255, 95, 67, 0.05) 0%, transparent 50%, rgba(255, 165, 78, 0.03) 100%);
  }

  .spotify-card {
    background: linear-gradient(135deg, rgba(29, 185, 84, 0.05) 0%, transparent 50%, rgba(29, 185, 84, 0.03) 100%);
  }

  /* Icon boxes */
  .icon-box {
    @apply flex h-11 w-11 items-center justify-center rounded-xl transition-transform duration-200;
  }
  
  .icon-accent {
    @apply bg-accent/15 text-accent;
  }
  
  .icon-mint {
    @apply bg-mint/15 text-mint;
  }
  
  .icon-orange {
    @apply bg-orange/15 text-orange;
  }
  
  .icon-tomato {
    @apply bg-tomato/15 text-tomato;
  }

  .group:hover .icon-box {
    transform: scale(1.1);
  }

  /* Badges */
  .badge {
    @apply rounded-full px-3 py-1 text-xs font-semibold;
  }
  
  .badge-accent {
    @apply bg-accent/15 text-accent;
  }
  
  .badge-mint {
    @apply bg-mint/15 text-mint;
  }
  
  .badge-tomato {
    @apply bg-tomato/15 text-tomato;
  }

  /* Tech Pills */
  .tech-pill {
    @apply rounded-full border border-border bg-card-hover px-3 py-1.5 text-xs font-medium text-text-secondary transition-all duration-200;
  }
  
  .tech-pill:hover {
    @apply border-accent/30 bg-accent/10 text-accent;
  }
  
  .tech-pill-accent {
    @apply rounded-full bg-accent/15 px-3 py-1.5 text-xs font-semibold text-accent;
  }

  /* Social Buttons */
  .social-btn {
    @apply flex h-11 w-11 items-center justify-center rounded-xl border border-border bg-card-hover text-text-muted transition-all duration-200;
  }
  
  .social-btn:hover {
    @apply border-accent/30 bg-accent/10 text-accent;
    transform: translateY(-2px);
  }

  /* Glass Card */
  .glass-card {
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(248, 237, 217, 0.1);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  /* Timeline */
  .timeline-item {
    @apply flex items-start gap-3;
  }

  .timeline-dot {
    @apply mt-2 h-2 w-2 shrink-0 rounded-full bg-text-muted/50;
  }
  
  .timeline-dot-active {
    @apply bg-accent;
    box-shadow: 0 0 8px rgba(128, 213, 128, 0.5);
  }

  .timeline-dot-tomato {
    @apply mt-2 h-2 w-2 shrink-0 rounded-full bg-text-muted/50;
  }
  
  .timeline-dot-tomato.timeline-dot-active {
    @apply bg-tomato;
    box-shadow: 0 0 8px rgba(255, 95, 67, 0.5);
  }

  /* Tech Marquee Card */
  .tech-marquee-card {
    @apply rounded-2xl overflow-hidden;
    background: rgba(24, 24, 27, 0.3);
  }

  /* Company Link Popup */
  .company-link-wrapper:hover .company-popup {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .company-link {
    position: relative;
  }

  /* Connect Links */
  .social-icon {
    @apply flex h-10 w-10 items-center justify-center rounded-full text-text-muted transition-all duration-300;
  }

  .social-icon:hover {
    @apply bg-accent/10 text-accent;
    transform: scale(1.15);
  }
</style>
