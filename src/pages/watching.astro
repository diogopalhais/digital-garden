---
import BaseLayout from '@layouts/BaseLayout.astro';
import ContentContainer from '@components/ContentContainer.astro';
import ContentHeader from '@components/ContentHeader.astro';
import TraktWatching from '@components/TraktWatching.jsx';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'watching');
const { Content } = await page.render();
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <section class="mx-auto max-w-5xl px-4 sm:px-6 py-16 md:py-24">
    <ContentContainer>
      <ContentHeader title={page.data.title} info={page.data.info} />

      <article>
        <Content />
      </article>

      <div class="mt-10">
        <TraktWatching client:load />
      </div>
    </ContentContainer>
  </section>
</BaseLayout>
