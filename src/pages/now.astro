---
import BaseLayout from '@layouts/BaseLayout.astro';
import Badge from '@components/Badge.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'now');
const { Content } = await page.render();

const updated = page.data.updated || 'Recently';
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <section class="mx-auto max-w-3xl px-4 sm:px-6 py-16">
    <header class="mb-12">
      <div class="mb-2 flex items-center gap-3">
        <p class="text-xs font-medium uppercase tracking-wider text-accent">What I'm up to</p>
        <Badge variant="accent">Updated {updated}</Badge>
      </div>
      <h1 class="mb-4 text-4xl font-bold text-text-primary md:text-5xl">
        {page.data.title}
      </h1>
    </header>

    <article class="prose-now">
      <Content />
    </article>
  </section>
</BaseLayout>

<style is:global>
  @reference "../styles/global.css";

  .prose-now {
    @apply max-w-none text-text-secondary;
  }

  .prose-now > p:first-of-type {
    @apply text-lg leading-relaxed mb-10 pb-10 border-b;
    color: color-mix(in srgb, var(--color-text-secondary) 80%, transparent);
    border-color: color-mix(in srgb, var(--color-border) 30%, transparent);
  }

  .prose-now h2 {
    @apply text-lg font-bold text-text-primary mt-14 mb-6 first:mt-0 pb-3 border-b;
    border-color: color-mix(in srgb, var(--color-accent) 30%, transparent);
  }

  .prose-now h3 {
    @apply text-xs font-medium text-text-muted mt-8 mb-3 uppercase tracking-widest pl-3 border-l-2 border-border;
    letter-spacing: 0.1em;
  }

  .prose-now p {
    @apply mb-4 leading-relaxed;
  }

  .prose-now strong {
    @apply text-text-primary font-medium;
  }

  .prose-now ul {
    @apply space-y-2 list-none pl-0 mb-6;
  }

  .prose-now li {
    @apply relative pl-4 text-text-secondary;
  }

  .prose-now li::before {
    @apply content-[''] absolute left-0 top-[0.6em] h-1 w-1 rounded-full bg-accent;
  }

  /* Task list styling */
  .prose-now li:has(input[type="checkbox"]) {
    @apply pl-0;
  }

  .prose-now li:has(input[type="checkbox"])::before {
    @apply content-none;
  }

  .prose-now input[type="checkbox"] {
    @apply hidden;
  }

  .prose-now li:has(input[type="checkbox"]:checked)::before {
    @apply content-['✓'] absolute left-0 top-0 h-auto w-auto rounded-none bg-transparent text-accent font-mono text-sm;
  }

  .prose-now li:has(input[type="checkbox"]:not(:checked))::before {
    @apply absolute left-0 top-0 h-auto w-auto rounded-none bg-transparent font-mono text-sm;
    content: '○';
    color: color-mix(in srgb, var(--color-text-muted) 40%, transparent);
  }

  .prose-now a {
    @apply text-accent hover:text-accent-hover transition-colors;
  }

  .prose-now hr {
    @apply my-10;
    border-color: color-mix(in srgb, var(--color-border) 30%, transparent);
  }
</style>
