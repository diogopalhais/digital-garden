---
import BaseLayout from '@layouts/BaseLayout.astro';
import ContentContainer from '@components/ContentContainer.astro';
import ContentHeader from '@components/ContentHeader.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'uses');
const { Content } = await page.render();
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <section class="mx-auto max-w-5xl px-4 sm:px-6 py-16 md:py-24">
    <ContentContainer>
      <ContentHeader title={page.data.title} updated={page.data.updated} />

      <article class="prose-uses">
        <Content />
      </article>
    </ContentContainer>
  </section>
</BaseLayout>

<style is:global>
  @reference "../styles/global.css";

  /* Uses page specific styling - list items as rows */
  /* Higher specificity to override ContentContainer article styles */
  .content-container article.prose-uses ul {
    @apply space-y-0 list-none pl-0 mb-8;
  }

  .content-container article.prose-uses li {
    @apply py-3 border-b last:border-b-0 pl-0;
    border-color: color-mix(in srgb, var(--color-border) 20%, transparent);
  }

  /* Mobile: hide em-dash by using font-size trick */
  @media (max-width: 767px) {
    .content-container article.prose-uses li:has(strong):has(em) {
      font-size: 0;
    }
  }

  .content-container article.prose-uses li::before {
    @apply content-none hidden;
  }

  .content-container article.prose-uses li strong {
    @apply block text-sm font-medium text-text-primary;
    @apply md:inline;
  }

  .content-container article.prose-uses li em {
    @apply not-italic text-xs text-text-muted block;
    @apply md:float-right md:block;
  }

  .content-container article.prose-uses li:not(:has(em)) {
    @apply text-text-secondary text-sm;
  }

  .content-container article.prose-uses li:not(:has(strong)) {
    @apply text-text-primary text-sm;
  }

  /* Image card styling */
  .prose-uses p:has(img) {
    @apply rounded-2xl border border-border overflow-hidden my-8 transition-all duration-300;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.3);
  }

  .prose-uses p:has(img):hover {
    @apply border-border-hover;
  }

  .prose-uses img {
    @apply w-full block transition-transform duration-700;
  }

  .prose-uses p:has(img):hover img {
    transform: scale(1.05);
  }
</style>
